{
  "name": "scrpg-vibe-coded",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "validate:data": "python3 scripts/validate_data.py",
    "check": "npm run validate:data && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dragdroptouch/drag-drop-touch": "^2.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "^0.26.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
